---
interface Props {
  title: string;
  subtitle: string;
  startDate: string;
  endDate: string;
  highlights: string[];
  lat: number;
  lng: number;
  ariaLabel: string;
  index: number;
}

const { title, subtitle, startDate, endDate, highlights, lat, lng, ariaLabel, index } = Astro.props;
---

<div class="animate-on-scroll relative pl-10" style={`transition-delay: ${index * 100}ms`} role="listitem">
  <div
    class="absolute left-3 top-2 -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-stone-500 border-[3px] border-stone-100 dark:border-stone-900"
    aria-hidden="true">
  </div>

  <div
    class="card map-card cursor-pointer group hover:shadow-md transition-all duration-300"
    data-lat={lat}
    data-lng={lng}
    aria-label={ariaLabel}
    tabindex="0">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mb-2">
      <div>
        <h4 class="font-bold text-stone-800 dark:text-stone-100">{title}</h4>
        <p class="text-stone-500 dark:text-stone-400 text-sm font-medium">{subtitle}</p>
      </div>
      <time
        class="font-mono text-xs text-stone-400 shrink-0 bg-stone-50 dark:bg-stone-700/50 px-2 py-1 rounded-md w-fit">
        {startDate} — {endDate}
      </time>
    </div>

    {
      highlights.length > 0 && (
        <ul class="space-y-1.5 mt-3">
          {highlights.map((h: string) => (
            <li class="flex items-baseline gap-2 text-stone-500 dark:text-stone-400 text-sm leading-relaxed">
              <span
                class="w-1 h-1 rounded-full bg-stone-400 dark:bg-stone-500 shrink-0 -translate-y-px"
                aria-hidden="true"
              />
              <span>{h}</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>
