---
import { getCollection } from "astro:content";
import InteractiveMap from "./InteractiveMap.astro";
import TimelineItem from "./TimelineItem.astro";

const experiences = (await getCollection("experience")).sort((a, b) => a.data.order - b.data.order);
const education = (await getCollection("education")).sort((a, b) => a.data.order - b.data.order);

const markers = [
  ...experiences.map((e) => ({
    lat: e.data.lat,
    lng: e.data.lng,
    title: e.data.company,
    subtitle: e.data.title,
    date: `${e.data.startDate} — ${e.data.endDate}`,
    type: "work" as const,
  })),
  ...education.map((e) => ({
    lat: e.data.lat,
    lng: e.data.lng,
    title: e.data.institution,
    subtitle: e.data.degree,
    date: `${e.data.startDate} — ${e.data.endDate}`,
    type: "education" as const,
  })),
];
---

<section id="experience" class="py-24 bg-stone-100/50 dark:bg-stone-800/30">
  <div class="max-w-7xl mx-auto px-6">
    <div class="animate-on-scroll">
      <span class="font-mono text-xs font-medium uppercase tracking-[3px] text-stone-400 mb-2 block"
        >Experience & Education</span
      >
      <h2 class="text-4xl font-extrabold mb-12 text-stone-800 dark:text-stone-100">Where I've worked & studied</h2>
    </div>

    <div class="grid lg:grid-cols-5 gap-10">
      <div class="lg:col-span-3">
        <h3 class="text-sm font-semibold text-stone-400 uppercase tracking-wider mb-6">Work Experience</h3>
        <div class="relative mb-12" role="list" aria-label="Work experience timeline">
          <div class="absolute left-3 top-2 bottom-0 w-px bg-stone-200 dark:bg-stone-700" aria-hidden="true"></div>
          <div class="space-y-8">
            {
              experiences.map((exp, i) => (
                <TimelineItem
                  title={exp.data.title}
                  subtitle={exp.data.company}
                  startDate={exp.data.startDate}
                  endDate={exp.data.endDate}
                  highlights={exp.data.highlights}
                  lat={exp.data.lat}
                  lng={exp.data.lng}
                  ariaLabel={`${exp.data.title} at ${exp.data.company} — click to view on map`}
                  index={i}
                />
              ))
            }
          </div>
        </div>

        <h3 class="text-sm font-semibold text-stone-400 uppercase tracking-wider mb-6">Education</h3>
        <div class="relative" role="list" aria-label="Education timeline">
          <div class="absolute left-3 top-2 bottom-0 w-px bg-stone-200 dark:bg-stone-700" aria-hidden="true"></div>
          <div class="space-y-8">
            {
              education.map((edu, i) => (
                <TimelineItem
                  title={edu.data.institution}
                  subtitle={edu.data.degree}
                  startDate={edu.data.startDate}
                  endDate={edu.data.endDate}
                  highlights={edu.data.highlights}
                  lat={edu.data.lat}
                  lng={edu.data.lng}
                  ariaLabel={`${edu.data.degree} at ${edu.data.institution} — click to view on map`}
                  index={i}
                />
              ))
            }
          </div>
        </div>
      </div>

      <div class="lg:col-span-2">
        <div class="lg:sticky lg:top-22.5">
          <div class="animate-on-scroll">
            <div class="flex flex-wrap items-center justify-between gap-4 mb-4" aria-label="Map legend">
              <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-stone-700 dark:bg-stone-300" aria-hidden="true"></span>
                  <span class="text-xs text-stone-500 dark:text-stone-400">Work</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-stone-400" aria-hidden="true"></span>
                  <span class="text-xs text-stone-500 dark:text-stone-400">Education</span>
                </div>
              </div>
              <span class="text-xs text-stone-400 italic">Click card to view on map</span>
            </div>

            <div
              class="rounded-2xl overflow-hidden border border-stone-200 dark:border-stone-700 shadow-sm"
              style="height: 500px;">
              <InteractiveMap markers={markers} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // Applies only CSS class changes — no layout reads.
    // Safe to call from MutationObserver without forcing a reflow.
    function applyCardVisuals(card) {
      if (!card) return;

      var isDark = document.documentElement.classList.contains("dark");

      document.querySelectorAll(".map-card").forEach((c) => {
        c.classList.remove("bg-white", "bg-stone-700", "shadow-md", "ring-1", "ring-stone-300", "ring-stone-600");
      });
      card.classList.add(
        isDark ? "bg-stone-700" : "bg-white",
        "shadow-md",
        "ring-1",
        isDark ? "ring-stone-600" : "ring-stone-300",
      );
    }

    // Full card activation: visuals + scroll-into-view (layout read is intentional here,
    // only called on user interaction, never from MutationObserver).
    function setActiveCard(card) {
      if (!card) return;

      applyCardVisuals(card);

      const rect = card.getBoundingClientRect();
      const isInViewport =
        rect.top >= 0 &&
        rect.left >= 0 &&
        rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&
        rect.right <= (window.innerWidth || document.documentElement.clientWidth);

      // Only scroll on desktop where side-by-side layout exists (lg breakpoint is 1024px)
      if (!isInViewport && window.innerWidth >= 1024) {
        card.scrollIntoView({ behavior: "smooth", block: "nearest" });
      }
    }

    // Re-apply active card styles when theme changes — visuals only, no layout read.
    const themeObserver = new MutationObserver(() => {
      const activeCard = document.querySelector(".map-card.shadow-md");
      if (activeCard) {
        applyCardVisuals(activeCard);
      }
    });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

    // Handle map marker selection events from the InteractiveMap component
    document.addEventListener("map-marker-selected", (e) => {
      const { lat, lng } = e.detail;
      const card = document.querySelector(`.map-card[data-lat="${lat}"][data-lng="${lng}"]`);
      setActiveCard(card);
    });

    // Handle card clicks to notify the map
    document.querySelectorAll(".map-card").forEach((card) => {
      const handleClick = (e) => {
        if (e.type === "keydown" && e.key !== "Enter" && e.key !== " ") {
          return;
        }
        if (e.type === "keydown") e.preventDefault();

        setActiveCard(card);

        const lat = parseFloat(card.dataset.lat);
        const lng = parseFloat(card.dataset.lng);
        document.dispatchEvent(
          new CustomEvent("fly-to-map", {
            detail: { lat, lng },
          }),
        );
      };

      card.addEventListener("click", handleClick);
      card.addEventListener("keydown", handleClick);
    });
  });
</script>
