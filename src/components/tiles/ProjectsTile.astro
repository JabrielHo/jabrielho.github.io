---
import GitHubIcon from "../icons/GitHubIcon.astro";
import ExternalLinkIcon from "../icons/ExternalLinkIcon.astro";

interface Project {
  title: string;
  course?: string;
  description: string[];
  tags: string[];
  startDate: string;
  endDate: string;
  github?: string;
  link?: string;
}
interface Props {
  projects: Project[];
  area?: string;
}
const { projects, area } = Astro.props;
---

<section class="tile projects-tile" style={area ? `grid-area:${area}` : undefined} aria-label="Projects">
  <h2 class="label">Projects</h2>
  <div class="cards">
    {
      projects.map((p) => (
        <article class="proj">
          <div class="proj-head">
            <div class="proj-head-text">
              <h3 class="proj-title">{p.title}</h3>
              {p.course && <p class="proj-course">{p.course}</p>}
            </div>
            <span class="proj-date">
              {p.startDate} — {p.endDate}
            </span>
          </div>
          <ul class="proj-desc">
            {p.description.map((d) => (
              <li>{d}</li>
            ))}
          </ul>
          <div class="proj-tags">
            {p.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
          {(p.github || p.link) && (
            <div class="proj-links">
              {p.github && (
                <a href={p.github} target="_blank" rel="noopener noreferrer">
                  <GitHubIcon /> <span>Source</span>
                </a>
              )}
              {p.link && (
                <a href={p.link} target="_blank" rel="noopener noreferrer">
                  <ExternalLinkIcon /> <span>Live demo</span>
                </a>
              )}
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .projects-tile {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-height: 0;
  }
  .label {
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-stone-500);
  }
  .cards {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    overflow-y: auto;
    padding-right: 0.25rem;
  }
  .proj {
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--color-stone-200);
    border-radius: 0.7rem;
    background: var(--color-stone-50);
  }
  :global(.dark) .proj {
    border-color: var(--color-stone-800);
    background: var(--color-stone-800);
  }
  .proj-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .proj-head-text {
    min-width: 0;
  }
  .proj-title {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-stone-900);
  }
  :global(.dark) .proj-title {
    color: var(--color-stone-50);
  }
  .proj-course {
    font-size: 0.7rem;
    color: var(--color-stone-500);
    margin-top: 0.1rem;
  }
  .proj-date {
    flex: none;
    font-size: 0.62rem;
    color: var(--color-stone-500);
    text-align: right;
    white-space: nowrap;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }
  .proj-desc {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0.5rem 0;
  }
  .proj-desc li {
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--color-stone-500);
    padding-left: 0.75rem;
    position: relative;
  }
  .proj-desc li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--color-stone-400);
  }
  .proj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .tag {
    font-size: 0.6rem;
    padding: 0.12rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--color-stone-300);
    color: var(--color-stone-600);
  }
  :global(.dark) .tag {
    border-color: var(--color-stone-700);
    color: var(--color-stone-300);
  }
  .proj-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.7rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--color-stone-200);
  }
  :global(.dark) .proj-links {
    border-color: var(--color-stone-800);
  }
  .proj-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-stone-500);
  }
  .proj-links a:hover {
    color: var(--color-stone-900);
  }
  :global(.dark) .proj-links a:hover {
    color: var(--color-stone-100);
  }
  :global(.dark) .proj-course,
  :global(.dark) .proj-desc li,
  :global(.dark) .proj-links a {
    color: var(--color-stone-300);
  }
  :global(.dark) .label,
  :global(.dark) .proj-date {
    color: var(--color-stone-400);
  }
</style>
